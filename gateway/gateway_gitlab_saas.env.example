# gitlab.com (SaaS) — gateway side. Copy to gateway/gateway_gitlab_saas.env.
# Containerized Stage 2 reaches the compose Redis by service name; for a
# single-host deployment use redis://localhost:6379/15 instead.
USE_REDIS=True
REDIS_URL=redis://redis:6379/15
GATEWAY_STREAM=gateway:stream

# --- webhook authentication (additive, default off) ------------------------
# `none` = the pre-auth behaviour: /webhook accepts any POST. On a
# public-facing deployment this is unauthenticated remote task execution —
# see docs/auth.md §1.
#
# `oidc` = require a GitLab CI id_token whose `project_id` claim matches the
# payload's project.id. Requires the CI-side snippet in
# infra/oidc-webhook/ and REPLACES GitLab's own webhook delivery.
WEBHOOK_AUTH_MODE=none
# Required when the mode is oidc; empty + oidc is a fatal misconfiguration,
# never a fallback to open.
OIDC_ISSUER=https://gitlab.com
# Must equal `aud` in the .gitlab-ci.yml snippet. No default on purpose — a
# guessable audience lets any project on the instance forge a trigger.
OIDC_AUDIENCE=
# Optional. Default: {issuer}/oauth/discovery/keys
#OIDC_JWKS_URL=
#OIDC_JWKS_CACHE_SECONDS=300
#OIDC_JWKS_MIN_REFRESH_SECONDS=60
#OIDC_LEEWAY_SECONDS=30
