USE_REDIS=True
REDIS_URL=redis://localhost:6379/15
GATEWAY_STREAM=gateway:stream

# Webhook authentication. `none` (default) keeps the pre-auth behaviour, which
# is what local/dev harnesses want. Set to `oidc` + OIDC_ISSUER/OIDC_AUDIENCE
# to require a GitLab CI id_token; see docs/auth.md and infra/oidc-webhook/.
WEBHOOK_AUTH_MODE=none
