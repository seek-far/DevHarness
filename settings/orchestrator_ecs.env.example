# ECS mode — orchestrator runs inside ECS, spawns workers via ecs:RunTask.
# Copy to orchestrator_ecs.env and fill in the real values (gitignored).
#
# Important: ENV stays "gitlab_saas" because we still talk to gitlab.com on
# the worker side (same HTTPS + oauth2:<token> auth path as host-mode AWS
# runs). The orchestrator's spawner choice is decoupled via WORKER_SPAWNER —
# the same pattern as Stage-2 docker. So the two-step loader reads
# orchestrator_gitlab_saas.env for the GitLab/Redis/LLM/heartbeat fields;
# the values below are layered on top (the CloudFormation stack injects
# them into the orchestrator container's task definition environment, so a
# physical orchestrator_ecs.env file is only useful for local dry-runs).
ENV=gitlab_saas
WORKER_SPAWNER=ecs
ECS_CLUSTER_NAME=sdlcma-cluster
ECS_WORKER_TASK_DEF=bf-worker
ECS_WORKER_SUBNETS=subnet-xxx,subnet-yyy
ECS_WORKER_SECURITY_GROUPS=sg-xxx
ECS_REGION=us-east-1
# ENV the spawned bf-worker container runs under; almost always gitlab_saas.
ECS_WORKER_ENV=gitlab_saas
