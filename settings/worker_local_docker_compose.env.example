ENV=local_docker_compose
REDIS_URL=redis://redis:6379/15
WORKER_HEARTBEAT_INTERVAL=10
WORKER_HEARTBEAT_TTL=30
STREAM_BLOCK_MS=1000
GITLAB_API=http://gitlab:80/api/v4
GITLAB_USERNAME=<your-gitlab-username>
GITLAB_SSH_PORT=22
# Project / group / personal access token — identical at the HTTP layer.
# Prefer a PROJECT access token; minimum grant is role Developer + scopes
# `api` + `write_repository`. See infra/gitlab-token/README.md.
GITLAB_PRIVATE_TOKEN=<your-gitlab-project-access-token>
LLM_API_KEY=<your-llm-api-key>
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-coder-480b-a35b-instruct
