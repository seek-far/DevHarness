ENV=local_multi_process
REDIS_URL=redis://localhost:6379/15
WORKER_HEARTBEAT_INTERVAL=10
WORKER_HEARTBEAT_TTL=30
STREAM_BLOCK_MS=1000
GITLAB_API=http://localhost:8080/api/v4
GITLAB_USERNAME=your_gitlab_username
GITLAB_PRIVATE_TOKEN=your_gitlab_private_token   # sensitive
LLM_API_KEY=your_llm_api_key                     # sensitive; omit for self-hosted (default "EMPTY")
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-coder-480b-a35b-instruct
# LLM_REQUEST_TIMEOUT=600                         # per-LLM-call HTTP timeout, sec; default 600

# ── self-hosted alternative (vLLM / llama.cpp / Ollama) ──────────────────────
# To use a local OpenAI-compatible backend instead of Dashscope:
#   1. Comment out the three LLM_* lines above.
#   2. Uncomment the block below.
#   3. LLM_MODEL must match the backend's served name exactly — vLLM defaults
#      to the HuggingFace path; override with `--served-model-name` if needed.
#      The worker queries {LLM_API_BASE_URL}/models at startup and aborts on
#      mismatch (set LLM_ALLOW_MODEL_MISMATCH=1 to bypass).
# LLM_API_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
# LLM_API_KEY is auto-defaulted to "EMPTY" for self-hosted — omit the line.
#
# For remote-eval (infra/remote-eval/deploy.sh): the deploy script auto-
# discovers the served model from {VLLM_URL}/models and rewrites the remote
# env file accordingly, so LLM_MODEL here is only the local-dev default.
# Future incremental sync to the remote host = re-run deploy.sh (rsync -az
# is already incremental).
