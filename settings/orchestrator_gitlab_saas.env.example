# gitlab.com (SaaS) — orchestrator side. Copy to
# settings/orchestrator_gitlab_saas.env (no secrets here).
#
# Two deployment shapes share this env:
#  * single host (infra/aws-gitlab, systemd): keep REDIS_URL=localhost, leave
#    WORKER_SPAWNER unset → subprocess worker (default).
#  * containerized (cloud Stage 2): REDIS_URL=redis://redis:6379/15,
#    WORKER_SPAWNER=docker + WORKER_IMAGE/DOCKER_NETWORK so the orchestrator
#    container spawns each worker as a container via the Docker socket.
ENV=gitlab_saas
REDIS_URL=redis://localhost:6379/15
GATEWAY_CONSUMER_GROUP=orchestrator-group-saas
GATEWAY_CONSUMER_NAME=orchestrator-0
WORKER_HEARTBEAT_INTERVAL=10
WORKER_HEARTBEAT_TTL=30
HEALTH_CHECK_INTERVAL=20
STREAM_BLOCK_MS=1000
STREAM_COUNT=20
# Containerized Stage 2 only (omit for single-host/systemd):
# WORKER_SPAWNER=docker
# WORKER_IMAGE=dh-bf-worker:latest
# DOCKER_NETWORK=sdlcma_net
