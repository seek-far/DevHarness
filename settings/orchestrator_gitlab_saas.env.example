# gitlab.com (SaaS) + single-host deployment — orchestrator side.
# Copy to settings/orchestrator_gitlab_saas.env (no secrets here).
ENV=gitlab_saas
REDIS_URL=redis://localhost:6379/15
GATEWAY_CONSUMER_GROUP=orchestrator-group-saas
GATEWAY_CONSUMER_NAME=orchestrator-0
WORKER_HEARTBEAT_INTERVAL=10
WORKER_HEARTBEAT_TTL=30
HEALTH_CHECK_INTERVAL=20
STREAM_BLOCK_MS=1000
STREAM_COUNT=20
