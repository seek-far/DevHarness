# gitlab.com (SaaS) + single-host deployment (pre-AWS rehearsal host or EC2).
# Two-step loader: set ENV=gitlab_saas in settings/.env, then copy this file
# to settings/worker_gitlab_saas.env and fill the sensitive values.
#
# Difference vs local_multi_process: GITLAB_API points at gitlab.com over
# HTTPS and the gitlab_saas provider branch does NO host rewrite; clone/push
# auth is https://oauth2:<GITLAB_PRIVATE_TOKEN>@gitlab.com/... (no SSH key).
ENV=gitlab_saas
REDIS_URL=redis://localhost:6379/15
WORKER_HEARTBEAT_INTERVAL=10
WORKER_HEARTBEAT_TTL=30
STREAM_BLOCK_MS=1000
GITLAB_API=https://gitlab.com/api/v4
# Used for the PRIVATE-TOKEN REST header and as the git credential. Use a
# short-lived Project/Group access token, role Developer, scopes: api +
# write_repository, least privilege — see infra/gitlab-token/README.md.
# ⚠️ gitlab.com's Free tier cannot create project/group access tokens (paid
# subscription required), so this SaaS harness may have to stay on a personal
# access token. Check Project → Settings → Access Tokens. The self-hosted
# harnesses have no such restriction and should not use a PAT.
# GITLAB_USERNAME is unused for git auth under gitlab_saas (oauth2 is the
# username) but kept for compatibility.
GITLAB_USERNAME=your_gitlab_username
GITLAB_PRIVATE_TOKEN=your_gitlab_com_access_token   # sensitive
LLM_API_KEY=your_llm_api_key                        # sensitive
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-coder-480b-a35b-instruct

# ── Azure OpenAI / Foundry backend (optional) ────────────────────────────────
# Azure's /openai/v1/ route is plain OpenAI shape — no api-version, no
# /openai/deployments/<dep>/ path, no api-key: header. So no Azure-specific
# client is needed; just point the ordinary settings at it.
#
# LLM_API_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# LLM_MODEL=gpt-5-mini              # the DEPLOYMENT name, not the model id
# LLM_PARAM_PROFILE=reasoning       # gpt-5 / o-series REJECT `temperature` (HTTP 400)
#
# Auth — pick one:
#   static key
# LLM_AUTH_MODE=api_key
# LLM_API_KEY=<key>
#   keyless: Managed Identity on Azure compute, `az login` locally (same code path)
# LLM_AUTH_MODE=entra
# LLM_ENTRA_CLIENT_ID=<uuid>        # only for a user-assigned identity
#
# The identity needs the `Cognitive Services OpenAI User` data-plane role on the
# resource. Subscription Owner is NOT enough.
