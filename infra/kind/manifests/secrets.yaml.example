# Stage 1a.2: secret material template. DO NOT commit a real `secrets.yaml`
# derived from this file — `.gitignore` excludes the suffix-less version.
#
# Preferred approach in 1a.2: create the Secret imperatively (values never
# touch disk in the repo):
#
#   kubectl create secret generic sdlcma-secrets -n sdlcma \
#     --from-literal=LLM_API_KEY="$LLM_API_KEY" \
#     --from-literal=GITLAB_PRIVATE_TOKEN="$GITLAB_PRIVATE_TOKEN" \
#     --from-file=SSH_PRIVATE_KEY=$HOME/.ssh/id_ed25519
#
# Verify:
#   kubectl get secret sdlcma-secrets -n sdlcma -o yaml
#   kubectl get secret sdlcma-secrets -n sdlcma -o jsonpath='{.data.LLM_API_KEY}' | base64 -d
#
# Rotate (recreate):
#   kubectl delete secret sdlcma-secrets -n sdlcma
#   kubectl create secret generic sdlcma-secrets -n sdlcma --from-literal=...
#   kubectl rollout restart deployment/orchestrator -n sdlcma
#
# The declarative form below is provided ONLY as a structural reference for
# what keys must exist. If you do use the declarative form, copy this file to
# `secrets.yaml` (gitignored), base64-encode each value, and `kubectl apply`.
#
# 1a.4 (Helm) and beyond will likely move to External Secrets Operator.

apiVersion: v1
kind: Secret
metadata:
  name: sdlcma-secrets
  namespace: sdlcma
type: Opaque
data:
  # echo -n 'sk-...' | base64
  LLM_API_KEY: PFJFUExBQ0VfTUVfQkFTRTY0Pg==
  # echo -n 'glpat-...' | base64
  GITLAB_PRIVATE_TOKEN: PFJFUExBQ0VfTUVfQkFTRTY0Pg==
  # cat ~/.ssh/id_ed25519 | base64 -w0
  SSH_PRIVATE_KEY: PFJFUExBQ0VfTUVfQkFTRTY0Pg==
